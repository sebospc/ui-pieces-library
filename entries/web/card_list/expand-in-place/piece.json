   },
   {
    "node": "row_act",
    "animate": "snappy",
    "press": "shrink"
   }
  ]
 },
 "accessibility": {
  "min_tap": "minTouch",
  "labels": {
   "row_open": "it.name",
   "row_act": "pill words and the name",
   "dim": "close_label",
   "card_close": "close_label"
  },
  "text_scales": true,
  "reduce_motion": "the phone drops rise, snappy and shrink",
