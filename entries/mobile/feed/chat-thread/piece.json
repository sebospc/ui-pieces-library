{
 "spec_version": "0.1.0",
 "slots": [
  {
   "name": "title",
   "type": "text",
   "required": true,
   "about": "the thread's name, the screen title"
  },
  {
   "name": "members",
   "type": "number",
   "required": true,
   "about": "how many people are in the thread"
  },
  {
   "name": "members_word",
   "type": "text",
   "required": true,
   "about": "after the member count, e.g. ' members'"
  },
  {
   "name": "me",
   "type": "text",
   "required": true,
   "about": "the name shown over this person's own messages"
  },
  {
   "name": "messages",
   "type": "list",
   "required": true,
   "about": "the thread, oldest first: id (sent order), author, mine (true for own), date, text"
  },
  {
   "name": "today_word",
   "type": "text",
   "required": true,
   "about": "the day divider for today"
  },
  {
   "name": "yesterday_word",
   "type": "text",
   "required": true,
   "about": "the day divider for yesterday"
  },
  {
   "name": "empty_text",
   "type": "text",
   "required": true,
   "about": "shown before anyone has written"
  },
  {
   "name": "field_label",
   "type": "text",
   "required": true,
   "about": "the spoken label and hint of the message field"
  },
  {
   "name": "send_text",
   "type": "text",
   "required": true,
   "about": "the send button's words"
  }
 ],
 "tokens": [
  "background",
  "surfaceRow",
  "separator",
  "accentFill",
  "onAccentFill",
  "accentContainer",
  "onAccentContainer",
  "textPrimary",
  "textSecondary",
  "radiusCard",
  "minTouch",
  "body",
  "caption",
  "buttonLabel"
 ],
 "scales": [
  "space0",
  "space2",
  "space4",
  "space5",
  "space6",
  "space8",
  "space9",
  "screenMargin"
 ],
 "behaviour": {
  "actions": [
   {
    "node": "field",
    "gesture": "tap",
    "event": "type"
   },
   {
    "node": "send",
    "gesture": "tap",
    "event": "send"
   }
  ],
  "states": {
   "empty": {
    "shows": "empty in place of the thread"
   },
   "fallback": {
    "shows": "send dimmed and doing nothing"
   }
  },
  "motion": [
   {
    "node": "row",
    "enter": "rise"
   },
   {
    "node": "send",
    "press": "shrink"
   },
   {
    "node": "send",
    "animate": "smooth"
   }
  ]
 },
 "accessibility": {
  "min_tap": "minTouch",
  "labels": {
   "field": "field_label",
   "send": "send_text"
  },
  "text_scales": true,
  "reduce_motion": "the phone drops rise and shrink"
 }
}
