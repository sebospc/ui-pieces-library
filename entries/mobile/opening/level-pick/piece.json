{
 "spec_version": "0.1.0",
 "slots": [
  {
   "name": "title",
   "type": "text",
   "required": true,
   "about": "the app's name, the screen title"
  },
  {
   "name": "step",
   "type": "number",
   "required": true,
   "about": "this step's place in the first run, 1 up"
  },
  {
   "name": "steps",
   "type": "number",
   "required": true,
   "about": "how many steps the first run has"
  },
  {
   "name": "ask",
   "type": "text",
   "required": true,
   "about": "the question"
  },
  {
   "name": "options",
   "type": "list",
   "required": true,
   "about": "2 to 4 ordered answers, lowest first: id (1 up, also the level), name, line"
  },
  {
   "name": "next_text",
   "type": "text",
   "required": true,
   "about": "the button's words"
  },
  {
   "name": "picked_word",
   "type": "text",
   "required": true,
   "about": "spoken after a picked option's name"
  },
  {
   "name": "done_line",
   "type": "text",
   "required": true,
   "about": "put before the picked name once the step is answered"
  },
  {
   "name": "change_text",
   "type": "text",
   "required": true,
   "about": "the button that brings the step back"
  }
 ],
 "tokens": [
  "background",
  "surfaceRow",
  "surfacePlaceholder",
  "accentFill",
  "onAccentFill",
  "accentContainer",
  "onAccentContainer",
  "textPrimary",
  "textSecondary",
  "radiusCard",
  "minTouch",
  "titleHero",
  "body",
  "caption",
  "buttonLabel"
 ],
 "scales": [
  "space1",
  "space2",
  "space3",
  "space4",
  "space5",
  "space6",
  "space7",
  "space8",
  "space9",
  "screenMargin"
 ],
 "behaviour": {
  "actions": [
   {
    "node": "card",
    "gesture": "tap",
    "event": "pick"
   },
   {
    "node": "next",
    "gesture": "tap",
    "event": "next"
   },
   {
    "node": "change",
    "gesture": "tap",
    "event": "change"
   }
  ],
  "states": {
   "fallback": {
    "shows": "next dimmed and doing nothing"
   },
   "attention": {
    "shows": "done_box in place of the question"
   }
  },
  "motion": [
   {
    "node": "card",
    "enter": "rise"
   },
   {
    "node": "card",
    "press": "shrink"
   },
   {
    "node": "next",
    "press": "shrink"
   },
   {
    "node": "step_on",
    "animate": "smooth"
   },
   {
    "node": "done_box",
    "enter": "rise"
   },
   {
    "node": "change",
    "press": "shrink"
   }
  ]
 },
 "accessibility": {
  "min_tap": "minTouch",
  "labels": {
   "card": "it.name (+ picked_word)",
   "next": "next_text",
   "change": "change_text"
  },
  "text_scales": true,
  "reduce_motion": "the phone drops rise, shrink and the smooth bar"
 }
}
